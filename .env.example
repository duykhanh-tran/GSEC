# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN (VERCEL / LOCAL)
# ==========================================

# 1. Supabase (Cơ sở dữ liệu & Xác thực người dùng)
# Lấy tại: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# 2. Google Gemini API Key (Dùng cho AI chấm điểm bài viết / tự luận)
# Lấy tại: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 3. AssemblyAI API Key (Dùng cho AI nhận diện giọng nói, bài luyện phát âm Form 4 & Form 5)
# Lấy tại: https://www.assemblyai.com/app/account
VITE_ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
